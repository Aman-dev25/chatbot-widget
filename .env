# ── Server ─────────────────────────────────────────────────
PORT=5000

# ── OpenAI (fill in when ready) ────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
USE_OPENAI=false

# ── MongoDB ────────────────────────────────────────────────
# Local:   mongodb://localhost:27017/chatbot
# Atlas:   mongodb+srv://user:pass@cluster.mongodb.net/chatbot
MONGODB_URI=mongodb://localhost:27017/chatbot
USE_MONGODB=false

# ── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# ── Domain Restriction ─────────────────────────────────────
# Comma-separated allowed origins. Blank = allow all.
ALLOWED_ORIGINS=

# ── Admin Panel ────────────────────────────────────────────
ADMIN_TOKEN=changeme_use_a_long_random_string

# ── Lead Capture ───────────────────────────────────────────
LEAD_CAPTURE_ENABLED=false
